{
  "name": "codepos-mx-dashboard",
  "productName": "CodePOS MX Dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Panel privado de analítica de CodePOS MX para Windows",
  "author": "CodePOS MX",
  "main": "main.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test",
    "dist": "node build-installer.js"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "mx.codepos.dashboard.local",
    "productName": "CodePOS MX Dashboard",
    "copyright": "CodePOS MX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "prompt/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../private-dashboard-build",
        "to": "Dashboard"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "CodePOS MX Dashboard",
      "artifactName": "CodePOS MX Dashboard Setup ${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
